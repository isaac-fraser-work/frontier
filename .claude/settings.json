{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "*.githubusercontent.com"
      ]
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": false
  }
}
